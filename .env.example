# Komic Freaks Studio — Environment Variables
# Copy this to .env and fill in your values

# ElevenLabs API Key (required for AI narration)
# Sign up at https://elevenlabs.io to get your key
VITE_ELEVENLABS_API_KEY=your_api_key_here

# Audio Proxy Worker URL (required for YouTube/URL clip extraction)
# Deploy the worker from /worker/ and paste your URL here
# e.g. https://komic-freaks-audio-proxy.your-account.workers.dev
VITE_AUDIO_PROXY_URL=http://localhost:8787
